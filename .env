# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME="Intelligent Research Assistant"
DEBUG=True

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
