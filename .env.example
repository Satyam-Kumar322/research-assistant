# ─── Application Settings ─────────────────────────────────────────────────────
APP_NAME="Intelligent Research Assistant"
DEBUG=True

# ─── Security ─────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-characters

# JWT token expiry in minutes (default: 60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (development — no setup needed)
# DATABASE_URL=sqlite:///./research_assistant.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://username:password@localhost:5432/research_assistant_db
mongodb+srv://Satyam:Satyam123@cluster0.qn4x01m.mongodb.net/?appName=Cluster0
# ─── Firebase Authentication ──────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase Admin SDK service account key JSON
# Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=firebase-service-account.json

# ─── OAuth (Optional — legacy, kept for reference) ────────────────────────────
# Google OAuth (direct — not needed when using Firebase)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
